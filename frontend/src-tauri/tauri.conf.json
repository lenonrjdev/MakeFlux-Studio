{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MakeFlux Studio",
  "version": "1.5.0",
  "identifier": "com.makeflux.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MakeFlux Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ateliux Technologies",
    "copyright": "© 2026 Ateliux Technologies",
    "shortDescription": "Estúdio desktop local para criação e produção de vídeos com inteligência artificial.",
    "longDescription": "MakeFlux Studio organiza roteiro, mídia, narração, legendas, renderização, biblioteca e publicação em um fluxo desktop integrado ao MoneyPrinterTurbo."
  }
}
