+export const classesCampo =
+  "foco-acessivel w-full rounded-md border border-[#dfe4e4] bg-white px-3 text-[11px] text-[#2f3435] placeholder:text-[#a0a6a7] hover:border-[#d2d8d8] focus:border-[#8fc6ba]";
